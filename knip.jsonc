{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // 検出対象は api-server と database（#306）。他 workspace は棚卸し未了のため対象外
  "ignoreWorkspaces": [".", "apps/beatfolio", "packages/ui", "packages/data"],
  "workspaces": {
    "apps/api-server": {
      // テスト専用ヘルパは production でも entry として残す（テストからしか呼ばれない export の検出対象から外す）
      "entry": ["src/usecases/**/testDoubles/**/*.ts!"],
      // "database" は tsconfig paths で packages/database の実ファイルへ解決されるため、依存としては未使用に見える
      "ignoreDependencies": ["database"],
    },
    "packages/database": {
      "entry": ["src/seed.ts!", "drizzle.config.ts!"],
      // drizzle.config.ts は読み込み時に DATABASE_URL を要求するため、プラグイン経由で評価させない
      "drizzle": false,
    },
  },
}
