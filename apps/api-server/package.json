{
  "name": "api-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest",
    "test:mutation": "stryker run",
    "test:mutation:domain": "stryker run --mutate \"src/domain/**/*.ts,!src/**/*.test.ts,!src/**/testDoubles/**,!src/**/entities/index.ts,!src/**/repositories/index.ts,!src/infrastructure/**\"",
    "test:mutation:incremental": "stryker run --incremental"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.22.0",
    "@hono/zod-validator": "^0.4.3",
    "@supabase/supabase-js": "^2.112.3",
    "database": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^27.0.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  }
}
