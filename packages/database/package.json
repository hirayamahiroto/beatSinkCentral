{
  "name": "database",
  "version": "1.0.0",
  "description": "ビートシンクデータベースモジュール",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:seed": "tsx src/seed.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.24.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
