{
  "name": "database",
  "version": "1.0.0",
  "description": "ビートシンクデータベースモジュール",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:seed": "tsx src/seed.ts",
    "lint": "eslint \"**/*.ts\"",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.24.0",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
